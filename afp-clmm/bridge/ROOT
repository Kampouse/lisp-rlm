chapter AFP

(* The bridge session: composes the escrow shell (CLMM_Escrow) with the
   fee ledger (User_Ledger) over one receipt stream. Deliberately NOT
   inside the AFP entry session (same policy as escrow/ and isabelle/).
   Both shells are siblings in the session tree, so BOTH chains are
   recompiled here, session-local, under the AFP entry heap (this also
   pins the bridge against the current escrow working state). Theory
   names are per-session; the copies are private to this session.
   Build with:
     PATH=/usr/sbin:$PATH isabelle build -o threads=2 -o document=false -d theory -D bridge
   (PATH note: Isabelle's mac hardware probe needs /usr/sbin/sysctl.) *)
session "CLMM_Bridge" = "Concentrated_Liquidity_Market_Making_Operations" +
  options [timeout = 1800]
  directories "committed"
  theories
    CLMM_Saturation
    CLMM_Curve
    CLMM_Escrow
    CLMM_Route
    Aggregate_Book
    Aggregate_Accrual
    User_Ledger
    CLMM_Bridge
