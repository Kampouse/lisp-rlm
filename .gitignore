!fixtures/guestbook.wasm
*.mjs
*.dot
*.png
near.json
# Root-level throwaway lisp scripts
/*.lisp
/fuzz_*.py
/gen_*.py
storage/
deploy/*/target/
deploy/*/main.lisp
deploy/*/near.json
near-vm-run/target/
sandbox-tests/target/
deploy/safe-sandbox/
