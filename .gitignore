.wrangler/
*.fst.checked
verification/**/*.checked

# build artifacts of the zk apps (npm install to restore)
node_modules/
# fuzz campaign artifacts (generators + harness stay; bulk corpora don't)
fuzz/corpus/
fuzz/results/
scripts/gaskey/node_modules/

# hardening subagent build dir (separate from target/)
/target-hardening/
# cross-process test lockfile (tests/common/mod.rs) — persistent by design,
# never unlinked (unlinking a flock'd file races open() into a new inode)
/runtime/.test.lock
