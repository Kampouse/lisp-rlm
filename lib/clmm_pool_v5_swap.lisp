;; swap: swap_rel v P s P' s', clamped to the span (M3, proof-fit).
;; up: v > 0 sell x -> out Y. down: v < 0 sell y -> out X.
;; 2026-10-15 emitter audit: multi-binding let* does NOT collide slots;
;; sequential single-binding lets kept (verified equivalent), loops return
;; one packed string "acc|rm".
(define (p5-swarm-dn s p xbook ybook v)
  (let ((imin (p5-imin)))
  (let ((gmin (p5-G (if (>= imin 0) imin 0))))
  (let ((res (loop ((pp p) (ss s) (acc "0") (rm v))
    (if (= (li-cmp rm "0") 0)
      (begin (p5-put "6|P" (to-string pp))
             (p5-put "6|S" ss)
             (str-cat acc (str-cat "|" rm)))
    (if (< (li-cmp ss gmin) 1)
      (begin (p5-put "6|P" (to-string pp))
             (p5-put "6|S" ss)
             (str-cat acc (str-cat "|" rm)))
    (let ((L (p5-bz (p5-lqkey pp))))
    (let ((gl (p5-G (- pp 1))))
    (let ((dxo (p5-dxo L ss gl)))
    (let ((dyi (p5-dyi L ss gl)))
      (if (< (li-cmp dyi rm) 1)
        (recur (- pp 1) gl (li-add acc dxo) (li-sub rm dyi))
        (let ((s2 (p5-sfdyi L ss rm)))
          (begin
            (p5-put "6|P" (to-string pp))
            (p5-put "6|S" s2)
            (str-cat (li-add acc (p5-dxo L ss s2)) (str-cat "|" "0"))))))))))))))
  (let ((out (p5-fst res)))
  (let ((rmf (p5-snd res)))
  (let ((xnew (li-add xbook out)))
  (let ((yin (li-sub v rmf)) (msg (str-cat "swap-out:" (str-cat out (str-cat ":rem:" rmf)))))
    (begin
      (p5-put "6|X" xnew)
      (p5-put "6|Y" (li-add ybook yin))
      (p5-put "6|LAST" msg)
      msg)))))))))

(define (p5-swarm-up s p xbook ybook v)
  (let ((imax (p5-imax)))
  (let ((gmax (p5-G (+ (if (>= imax 0) imax 0) 1))))
  (let ((res (loop ((pp p) (ss s) (acc "0") (rm v))
    (if (= (li-cmp rm "0") 0)
      (begin (p5-put "6|P" (to-string pp))
             (p5-put "6|S" ss)
             (str-cat acc (str-cat "|" rm)))
    (if (>= (li-cmp ss gmax) 0)
      (begin (p5-put "6|P" (to-string pp))
             (p5-put "6|S" ss)
             (str-cat acc (str-cat "|" rm)))
    (let ((L (p5-bz (p5-lqkey pp))))
    (let ((gh (p5-G (+ pp 1))))
    (let ((dy (p5-dy L ss gh)))
    (let ((dx (p5-dx L ss gh)))
      (if (< (li-cmp dx rm) 1)
        (recur (+ pp 1) gh (li-add acc dy) (li-sub rm dx))
        (let ((s2 (p5-sfdx L ss rm)))
          (begin
            (p5-put "6|P" (to-string pp))
            (p5-put "6|S" s2)
            (str-cat (li-add acc (p5-dy L ss s2)) (str-cat "|" "0"))))))))))))))
  (let ((out (p5-fst res)))
  (let ((rmf (p5-snd res)))
  (let ((ynew (li-add ybook out)))
  (let ((xin (li-sub v rmf)) (msg (str-cat "swap-out:" (str-cat out (str-cat ":rem:" rmf)))))
    (begin
      (p5-put "6|Y" ynew)
      (p5-put "6|X" (li-add xbook xin))
      (p5-put "6|LAST" msg)
      msg)))))))))

(define (p5-swap)
  (let ((inp (near/input)))
  (let ((v (json-get-str "v" inp)))
  (let ((neg (if (str= (str-slice v 0 1) "-") 1 0)))
  (let ((v (if (= neg 1) (str-slice v 1 (str-len v)) v)))
  (let ((s (p5-bz "6|S")))
  (let ((p (str->num (p5-bz "6|P"))))
  (let ((xbook (p5-bz "6|X")))
  (let ((ybook (p5-bz "6|Y")))
    (if (= (str-len (p5-bz "6|TOKX")) 0)
        "ERR_INIT"
    (if (= (li-cmp v "0") 0)
        "swap-zero"
    (if (= neg 1)
        (p5-swarm-dn s p xbook ybook v)
        (p5-swarm-up s p xbook ybook v)))))))))))))
