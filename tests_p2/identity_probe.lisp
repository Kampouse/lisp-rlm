;; Identity-source probe: what attested identity does the OutLayer worker
;; expose to the component? Dumps candidates as JSON. The "caller" input
;; field is included for comparison (spoofed value).
(define (env-or name)
  (let ((v (env/get name)))
    (if (and v (< 0 (str-len (if v v "")))) v "?")))
(define (run input)
  (let* ((c1 (env-or "NEAR_ACCOUNT_ID"))
         (c2 (env-or "SENDER_ID"))
         (c3 (env-or "PREDECESSOR_ID"))
         (c4 (env-or "OUTLAYER_SENDER_ID"))
         (c5 (env-or "SIGNER_ID"))
         (c6 (env-or "ACCOUNT_ID"))
         (c7 (env-or "OUTLAYER_ACCOUNT_ID"))
         (sp (json-get-str "caller" input))
         (o1 (str-cat "{\"NEAR_ACCOUNT_ID\":\"" c1))
         (o2 (str-cat o1 (str-cat "\",\"SENDER_ID\":\"" c2)))
         (o3 (str-cat o2 (str-cat "\",\"PREDECESSOR_ID\":\"" c3)))
         (o4 (str-cat o3 (str-cat "\",\"OUTLAYER_SENDER_ID\":\"" c4)))
         (o5 (str-cat o4 (str-cat "\",\"SIGNER_ID\":\"" c5)))
         (o6 (str-cat o5 (str-cat "\",\"ACCOUNT_ID\":\"" c6)))
         (o7 (str-cat o6 (str-cat "\",\"OUTLAYER_ACCOUNT_ID\":\"" c7)))
         (o8 (str-cat o7 (str-cat "\",\"input_caller\":\"" (if sp sp "?")))))
    (str-cat o8 "\"}")))
